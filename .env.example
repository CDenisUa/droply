# Backend (apps/api)
DATABASE_URL=postgres://droply:droply@localhost:5434/droply
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
RUST_LOG=info
# Where in-progress/completed downloads are staged before being served —
# not permanent storage, see docs/architecture.md §44. Defaults to
# <OS temp dir>/droply if unset.
TEMP_STORAGE_PATH=/tmp/droply

# Frontend (apps/web) — see apps/web/.env.example
